# O.S.A. — пример файла с переменными окружения
# Скопируйте этот файл в `.env` и заполните своими значениями:
#   cp .env.example .env
#
# ВНИМАНИЕ: `.env` добавлен в `.gitignore`, случайный коммит не случится.
# Но всё равно не публикуйте свой ключ нигде.

# API-ключ для LLM-провайдера
OSA_LLM__API_KEY=your-key-here

# Провайдер: minimax | openai_compat | stub
OSA_LLM__PROVIDER=minimax

# Endpoint и модель
OSA_LLM__BASE_URL=https://api.minimax.io/v1
OSA_LLM__MODEL=MiniMax-M3

# Таймаут HTTP-запроса (сек)
OSA_LLM__TIMEOUT=30.0

# Повторы при сетевых ошибках
OSA_LLM__MAX_RETRIES=3

# Логи
OSA_LOGGING__LEVEL=info
OSA_LOGGING__JSON=true

# Telegram-бот (опционально)
# Получи токен через @BotFather в Telegram
OSA_TELEGRAM__BOT_TOKEN=
# Список разрешённых user_id через запятую. Узнай свой через @userinfobot
OSA_TELEGRAM__ALLOWED_USERS=
# Таймаут long polling (сек)
OSA_TELEGRAM__POLL_TIMEOUT=30.0
# Авто-одобрение shell-команд в боте (без подтверждения Y/N)
OSA_TELEGRAM__AUTO_APPROVE=false

# Тестовое окружение (только для разработки, НЕ для production)
# OSA_HOME=/tmp/osa-test
